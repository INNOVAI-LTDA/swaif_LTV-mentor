# ==============================
# Migration Kit - Environment
# ==============================
# Fill these values in the target repository.

# --- Backend ---
APP_ENV=production
CLIENT_CODE=<client_code>
CORS_ALLOW_ORIGINS=https://<frontend-domain>
APP_AUTH_SECRET=<strong-random-secret>
ENABLE_MENTOR_ROUTES=true
STORAGE_BACKUP_DIR=/app/data/backups

# Postgres/Supabase runtime persistence
# Use a postgres connection string (not a project URL).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Frontend ---
VITE_DEPLOY_TARGET=client
VITE_CLIENT_CODE=<client_code>
VITE_API_BASE_URL=https://<backend-domain>
VITE_APP_BASE_PATH=/
VITE_CLIENT_NAME=<client_name>
VITE_APP_NAME=<product_name>
VITE_APP_TAGLINE=<product_tagline>
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_INTERNAL_MENTOR_SURFACE=false
