# ==============================
# Migration Kit - Environment
# ==============================
# Fill these values in the target repository.

# --- Backend ---
APP_ENV=production
CLIENT_CODE=<client_code>
CORS_ALLOW_ORIGINS=https://<frontend-domain>
APP_AUTH_SECRET=<strong-random-secret>
ENABLE_MENTOR_ROUTES=true
STORAGE_BACKUP_DIR=/app/data/backups

# Postgres/Supabase runtime persistence
# Use a postgres connection string (not a project URL).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Frontend ---
# Build target is mandatory: local (dev) or client (published build).
VITE_DEPLOY_TARGET=client
# Must match backend CLIENT_CODE in the same deploy.
VITE_CLIENT_CODE=<client_code>
# Client builds require an explicit absolute http(s) URL (without credentials/query/hash).
VITE_API_BASE_URL=https://<backend-domain>
VITE_HTTP_TIMEOUT_MS=15000
# Use / for root deploy or /cliente/mentoria/ for subpath deploys.
VITE_APP_BASE_PATH=/

# Branding / product copy
VITE_CLIENT_NAME=<client_name>
VITE_APP_NAME=<product_name>
VITE_APP_TAGLINE=<product_tagline>
VITE_SHELL_SUBTITLE=<shell_subtitle>
VITE_BRANDING_ICON_PATH=branding/app-icon.png
VITE_BRANDING_LOGO_PATH=branding/app-logo.png
VITE_BRANDING_LOGIN_HERO_PATH=branding/login-hero.png

# Optional theme tokens
VITE_THEME_BG_PRIMARY=#090909
VITE_THEME_BG_SECONDARY=#121212
VITE_THEME_SURFACE_PRIMARY=#1A1A1A
VITE_THEME_SURFACE_SECONDARY=#242424
VITE_THEME_BORDER_DEFAULT=#333333
VITE_THEME_TEXT_PRIMARY=#FFFFFF
VITE_THEME_TEXT_SECONDARY=#BFBFBF
VITE_THEME_ACCENT_PRIMARY=#FAB800
VITE_THEME_ACCENT_SECONDARY=#FFBD00
VITE_THEME_SUCCESS=#39B56A
VITE_THEME_WARNING=#D9A100
VITE_THEME_DANGER=#D64545

# Keep disabled for client environments.
VITE_ENABLE_DEMO_MODE=false
# Canonical gate for internal mentor-demo compatibility.
VITE_ENABLE_INTERNAL_MENTOR_SURFACE=false
# Legacy alias still supported by runtime if needed:
# VITE_ENABLE_INTERNAL_MENTOR_DEMO=false
